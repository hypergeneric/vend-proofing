<?php
	// Separate from the SPA so an emailed link works even when another account is signed in.
	header('Cache-Control: no-store');
	header('Referrer-Policy: no-referrer');
	header('X-Robots-Tag: noindex, nofollow');
	$text = static function (string $key) use ($LANG): string {
		return htmlspecialchars($LANG->lookup($key), ENT_QUOTES, 'UTF-8');
	};
	$field = static function (string $key): string {
		return isset($_POST[$key]) && is_string($_POST[$key]) ? $_POST[$key] : '';
	};
	$csrf = $_COOKIE['VEND_RECOVERY'] ?? '';
	if (!is_string($csrf) || !preg_match('/^[a-f0-9]{64}$/', $csrf)) {
		$csrf = bin2hex(random_bytes(32));
		setcookie('VEND_RECOVERY', $csrf, [
			'path' => '/', 'httponly' => true, 'samesite' => 'Strict',
			'secure' => (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') || ($_SERVER['HTTP_X_FORWARDED_PROTO'] ?? '') === 'https',
		]);
	}
	$message = '';
	$resetToken = $field('reset_token');
	$resetMode = $field('recovery_action') === 'reset';
	$done = false;
	if ($_SERVER['REQUEST_METHOD'] === 'POST') {
		if ($field('recovery_csrf') === '' || !hash_equals($csrf, $field('recovery_csrf'))) {
			$message = 'Recovery Form Expired';
		} elseif ($resetMode) {
			if (strlen($field('password')) < 12 || strlen($field('password')) > 4096) {
				$message = 'Account Password Length';
			} elseif ($field('password') !== $field('confirm_password')) {
				$message = 'Account Password Mismatch';
			} elseif (PasswordRecovery::reset($resetToken, $field('password'))) {
				$message = 'Recovery Complete';
				$done = true;
				$resetToken = '';
			} else {
				$message = 'Recovery Link Invalid';
			}
		} else {
			try {
				PasswordRecovery::request($field('username'), $_SERVER['REMOTE_ADDR'] ?? 'unknown');
			} catch (Throwable $error) {
				error_log('Vend administrator recovery unavailable; check database migrations and mail configuration.');
			}
			$message = 'Recovery Request Sent';
		}
	}
?>
<!doctype html>
<html lang="<?php echo htmlspecialchars($LANG->code, ENT_QUOTES, 'UTF-8'); ?>">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="referrer" content="no-referrer">
	<title><?php echo $text('Password Recovery'); ?></title>
	<link rel="stylesheet" href="<?php echo SA_DIR_COREPATH; ?>/css/admin-shell.css?v=<?php echo filemtime(SA_DIR_COREPATH . '/css/admin-shell.css'); ?>">
</head>
<body class="Recovery">
	<div id="container"><div id="content"><div class="PanelBox">
		<div class="Top"><h2><?php echo $text('Password Recovery'); ?></h2></div>
		<div class="Body">
			<noscript><p><?php echo $text('Recovery Javascript Required'); ?></p></noscript>
			<?php if ($message !== '') { ?><p role="status"><?php echo $text($message); ?></p><?php } ?>
			<?php if (!$done) { ?>
			<form id="recovery-request" action="?/admin/&amp;recover=1" method="post" <?php if ($resetMode) echo 'hidden'; ?>>
				<p class="Description"><?php echo $text('Recovery Request Description'); ?></p>
				<input type="hidden" name="recovery_csrf" value="<?php echo $csrf; ?>">
				<input type="hidden" name="recovery_action" value="request">
				<label class="formtitle" for="recovery-username"><?php echo $text('Username'); ?></label>
				<input id="recovery-username" name="username" type="text" maxlength="80" autocomplete="username" required>
				<button class="InputButton" type="submit"><?php echo $text('Send Reset Link'); ?></button>
			</form>
			<form id="recovery-reset" action="?/admin/&amp;recover=1" method="post" <?php if (!$resetMode) echo 'hidden'; ?>>
				<p class="Description"><?php echo $text('Account Password Length'); ?></p>
				<input type="hidden" name="recovery_csrf" value="<?php echo $csrf; ?>">
				<input type="hidden" name="recovery_action" value="reset">
				<input id="reset-token" type="hidden" name="reset_token" value="<?php echo htmlspecialchars($resetToken, ENT_QUOTES, 'UTF-8'); ?>">
				<label class="formtitle" for="new-password"><?php echo $text('New Password'); ?></label>
				<input id="new-password" name="password" type="password" minlength="12" maxlength="4096" autocomplete="new-password" required>
				<label class="formtitle" for="confirm-password"><?php echo $text('Confirm Password'); ?></label>
				<input id="confirm-password" name="confirm_password" type="password" minlength="12" maxlength="4096" autocomplete="new-password" required>
				<button class="InputButton" type="submit"><?php echo $text('Reset Password'); ?></button>
			</form>
			<?php } ?>
			<p><a href="?/admin/"><?php echo $text('Back To Login'); ?></a></p>
		</div>
	</div></div></div>
	<script>
		(function () {
			function openReset () {
				var fragment = window.location.hash;
				if (fragment.indexOf('#token=') !== 0) return;
				if (!document.getElementById('reset-token')) { window.location.reload(); return; }
				// Keep the bearer credential out of HTTP requests, referrers, and subsequent history entries.
				window.history.replaceState(null, '', window.location.pathname + window.location.search);
				var token = fragment.substring(7);
				document.getElementById('recovery-request').hidden = true;
				document.getElementById('recovery-reset').hidden = false;
				document.getElementById('reset-token').value = token;
			}
			window.addEventListener('hashchange', openReset);
			openReset();
		}());
	</script>
</body>
</html>
